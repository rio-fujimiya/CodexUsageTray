<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_compact"
    android:paddingLeft="4dp"
    android:paddingTop="5dp"
    android:paddingRight="4dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/compact_five_ring"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="5-hour remaining quota" />

            <TextView
                android:id="@+id/compact_five_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="--:--"
                android:textColor="#CFD4DB"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/compact_week_ring"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="Weekly remaining quota" />

            <TextView
                android:id="@+id/compact_week_reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans"
                android:gravity="center"
                android:maxLines="1"
                android:text="--/--"
                android:textColor="#CFD4DB"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/compact_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:text=""
        android:textColor="#FFB4AB"
        android:textSize="6sp"
        android:textStyle="bold" />
</FrameLayout>
